# LabClear configuration. Copy to .env for local use. Never commit a filled .env.
APP_ENV=development

# ── AI ───────────────────────────────────────────────────────────────────────────
# AI stays off until this is true. Providers and keys can then be set on
# /staff → AI providers (manager), or below as a fallback.
PROVIDER_NETWORK_ENABLED=false

# Language model: typhoon, openai, anthropic, gemini, huggingface, openrouter, xai, moonshot, qwen, deepseek, custom
LLM_PROVIDER=typhoon
LLM_API_KEY=
LLM_MODEL=
# Safety check: iapp_systemone (OpenThai-SystemOne), typesafe_jev (Jev), llama_guard (via OpenRouter)
GUARD_PROVIDER=iapp_systemone
GUARD_API_KEY=
# Report reading: typhoon_ocr, openai, gemini, openrouter, custom
VISION_ENABLED=true
VISION_PROVIDER=typhoon_ocr
VISION_API_KEY=

# ── Spending limits ──────────────────────────────────────────────────────────────
# Total AI calls allowed in this cycle (a new cycle name starts a new count; one message uses about 5 calls)
PROVIDER_BUDGET_CYCLE_ID=labclear-1
CLOUD_CALL_LIMIT=500
# Project-total THB budget; prior spend must be stated (0 for a new project)
PROJECT_BUDGET_THB=300
PROJECT_BUDGET_PRIOR_SPEND_THB=0

# ── Optional ─────────────────────────────────────────────────────────────────────
# When set (12+ characters), visitors must enter this code before using the AI.
DEMO_ACCESS_CODE=
# Shared demo accounts test-01 (Free), test-02 (Plus) and admin (manager), password 1234.
# Empty = on for a local run, off on Render/Vercel. Set true to use them on a hosted demo,
# and false again afterwards: anyone who knows them can sign in, admin included.
DEMO_ACCOUNTS=
# Sign in with Google for customers (OAuth client from Google Cloud Console; see docs/deploy/render.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only when the redirect address differs from BUSINESS_PUBLIC_URL + /api/business/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── Hosting only (local runs use an encrypted SQLite file in data/) ─────────────
DATABASE_URL=
BUSINESS_DATA_KEY=
