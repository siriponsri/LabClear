# LabClear configuration. Copy to .env for local use. Never commit a filled .env.
APP_ENV=development

# ── AI models (OpenAI-compatible) ─────────────────────────────────────────────
# Typhoon (free tier): https://playground.opentyphoon.ai  → API key
LLM_API_KEY=
LLM_MODEL=typhoon-v2.5-30b-a3b-instruct
# Report reading with Typhoon OCR (the same Typhoon key works)
VISION_ENABLED=true
VISION_API_KEY=
VISION_MODEL=typhoon-ocr
# Safety screening with Llama Guard 4 via OpenRouter (paid, about $0.18 per million tokens)
GUARD_API_KEY=
GUARD_MODEL=meta-llama/llama-guard-4-12b

# ── Spending limits (all three must be set before any AI call) ────────────────
# Turn on only after the keys and limits below are filled in
PROVIDER_NETWORK_ENABLED=false
PROVIDER_BUDGET_CYCLE_ID=labclear-1
# Hosted (DATABASE_URL set): total AI calls for this cycle, counted in PostgreSQL
CLOUD_CALL_LIMIT=500
# Local (no DATABASE_URL): run `python scripts/provider_budget_cycle.py create` once
PROVIDER_BUDGET_LLM_LIMIT=500
PROVIDER_BUDGET_OCR_LIMIT=50
# Project-total budget in THB; prior spend must be stated (0 for a new project)
PROJECT_BUDGET_THB=300
PROJECT_BUDGET_PRIOR_SPEND_THB=0
# THB per one million tokens. Conservative estimates; edit to your real prices.
MODEL_PRICES_THB={"typhoon-v2.5-30b-a3b-instruct":{"input_per_mtok":10,"output_per_mtok":10},"typhoon-ocr":{"input_per_mtok":10,"output_per_mtok":10},"meta-llama/llama-guard-4-12b":{"input_per_mtok":7,"output_per_mtok":7}}

# ── Optional ──────────────────────────────────────────────────────────────────
# When set (12+ characters), visitors must enter this code before using the AI.
DEMO_ACCESS_CODE=

# ── Storage (hosted only; local runs use an encrypted SQLite file in data/) ───
# PostgreSQL connection string, e.g. Render "Internal Database URL"
DATABASE_URL=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BUSINESS_DATA_KEY=
