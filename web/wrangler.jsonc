{
  "$schema": "node_modules/wrangler/config-schema.json",
  // LabClear website (Next.js through OpenNext). /api and /health go to the API worker
  // (../deploy/cloudflare, a Cloudflare Container running FastAPI) via the API service binding.
  "name": "labclear-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "labclear-web" },
    { "binding": "API", "service": "labclear-api" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Set your domain with:  npm run cf:domain -- labclear.example.com
  // (writes "routes": [{ "pattern": "<domain>", "custom_domain": true }] below)
  "routes": []
}
